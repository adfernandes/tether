# Copy to .env in this directory, then replace with your actual host identity/paths.
# Run id -u and id -g as the non-root user that should own Tether's state.
TETHER_UID=1000
TETHER_GID=1000
# Pre-create these outside the repository; /data must be private (mode 0700).
TETHER_DATA_DIR=/home/your-user/.local/share/tether-container
TETHER_DOWNLOADS_DIR=/home/your-user/tether-inbox
TETHER_HOSTNAME=tether
# Set this only after verifying the controller setting on the host.
# Containers cannot run host Bluetooth management tools reliably.
TETHER_BLUEZ_SECURE_CONNECTIONS=1
# Optional local build label. No image is published by this configuration.
TETHER_VERSION=0.2.32-container-dev
